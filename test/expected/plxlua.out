-- multiple assignment evaluates every value first
CREATE FUNCTION lua_swap(a int, b int) RETURNS text LANGUAGE plxlua AS $$
local x, y = a, b
x, y = y, x
local p, q = 1 --:: int
local t = {1, 2}
t[1], t[2] = 10, 20
return x .. "," .. y .. "," .. p .. "," .. tostring(q == nil) .. "," .. t[1] + t[2]
$$;
SELECT lua_swap(1, 2);
   lua_swap    
---------------
 2,1,1,true,30
(1 row)

