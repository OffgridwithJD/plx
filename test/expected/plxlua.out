   a text := E'tab\tnl\\n q"'' AB☺ joined';     +
   b text := 'it''s';                           +
   c text := E'back\\slash ]] stays';           +
   d text := 'first newline dropped';           +
 BEGIN                                          +
   RETURN a || '|' || b || '|' || c || '|' || d;+
 END;                                           +
 
(1 row)

