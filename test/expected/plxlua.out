CREATE FUNCTION lua_nums() RETURNS text LANGUAGE plxlua AS $$
return 0xFF .. " " .. 1e3 .. " " .. .5 .. " " .. 3. .. " " .. 3000000000
$$;
SELECT lua_nums();
