-- ================================================================ errors
CREATE FUNCTION lua_err(n int) RETURNS int LANGUAGE plxlua AS $$
if n < 0 then error("negative: " .. n) end
if n == 0 then error("zero", 2) end
if n > 100 then
  error{message = "too big", sqlstate = "22023", detail = "n is " .. n, hint = "use 100 or less"}
end
return n
$$;
