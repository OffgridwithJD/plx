-- names plpgsql cannot take as variables are renamed
CREATE FUNCTION lua_reserved() RETURNS text LANGUAGE plxlua AS $$
local user = "u"
local left, right = 1, 2
local limit = 10
for loop = 1, 2 do limit = limit + loop end
return user .. left .. right .. limit
$$;
