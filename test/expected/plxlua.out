NOTICE:  sum	6
SET client_min_messages = warning;
-- ================================================================ ipairs
CREATE FUNCTION lua_ipairs(a int[]) RETURNS text LANGUAGE plxlua AS $$
local total, idx = 0, 0
for i, v in ipairs(a) do
  total = total + v
  idx = idx + i
end
local names = {"x", "y"}
local s = ""
for _, nm in ipairs(names) do s = s .. nm end
local cnt = 0
for i in ipairs(a) do cnt = cnt + 1 end
local u = {} --:: text[]
for _, w in ipairs(u) do --:: text
  s = s .. w
end
return total .. "/" .. idx .. "/" .. s .. "/" .. cnt
$$;
SELECT lua_ipairs(ARRAY[1, 2, 3]);
 lua_ipairs 
------------
 6/6/xy/3
(1 row)

SELECT lua_src('lua_ipairs');
                                     lua_src                                     
---------------------------------------------------------------------------------
 DECLARE                                                                        +
   total integer := 0;                                                          +
   idx integer := 0;                                                            +
   i integer;                                                                   +
   v integer;                                                                   +
   names text[] := ARRAY['x', 'y'];                                             +
   s public.plx_strbuild := '';                                                 +
   nm text;                                                                     +
   cnt integer := 0;                                                            +
   u text[] := '{}';                                                            +
   w text;                                                                      +
 BEGIN                                                                          +
   i := 0;                                                                      +
   FOREACH v IN ARRAY a LOOP                                                    +
     i := i + 1;                                                                +
     total := total + v;                                                        +
     idx := idx + i;                                                            +
   END LOOP;                                                                    +
   FOREACH nm IN ARRAY names LOOP                                               +
     s := public.plx_sb_append(s, nm);                                          +
   END LOOP;                                                                    +
   FOR i IN 1..cardinality(a) LOOP                                              +
     cnt := cnt + 1;                                                            +
   END LOOP;                                                                    +
   FOREACH w IN ARRAY u LOOP                                                    +
     s := public.plx_sb_append(s, w);                                           +
   END LOOP;                                                                    +
   RETURN total::text || '/' || idx::text || '/' || s::text || '/' || cnt::text;+
 END;                                                                           +
 
(1 row)

