-------------+-------------+-------------
           3 |          -1 |            
(1 row)

SELECT lua_src('lua_safediv');
                 lua_src                  
------------------------------------------
 DECLARE                                 +
   r int;                                +
   ok boolean;                           +
   err text;                             +
 BEGIN                                   +
   BEGIN                                 +
     r := floor(a::numeric / b)::integer;+
     ok := true;                         +
     err := NULL;                        +
   EXCEPTION WHEN OTHERS THEN            +
     ok := false;                        +
     err := SQLERRM;                     +
   END;                                  +
   IF NOT ok THEN                        +
     RETURN -1;                          +
   END IF;                               +
   RETURN r;                             +
 END;                                    +
 
(1 row)

CREATE TABLE lua_uniq(id int PRIMARY KEY);
CREATE FUNCTION lua_ins(k int) RETURNS text LANGUAGE plxlua AS $$
local ok, err = pcall(function()
  execute("INSERT INTO lua_uniq VALUES ($1)", k)
end)
if ok then return "inserted" end
if err.sqlstate == "23505" then
  return "duplicate on " .. err.constraint .. ": " .. err
end
error(err)
$$;
SELECT lua_ins(1), lua_ins(1);
 lua_ins  |                                          lua_ins                                           
----------+--------------------------------------------------------------------------------------------
 inserted | duplicate on lua_uniq_pkey: duplicate key value violates unique constraint "lua_uniq_pkey"
(1 row)

SELECT lua_src('lua_ins');
                                                                                       lua_src                                                                                       
-------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
 DECLARE                                                                                                                                                                            +
   ok boolean;                                                                                                                                                                      +
   err text;                                                                                                                                                                        +
   __plx_e1_sqlstate text;                                                                                                                                                          +
   __plx_e1_detail text;                                                                                                                                                            +
   __plx_e1_hint text;                                                                                                                                                              +
   __plx_e1_constraint text;                                                                                                                                                        +
 BEGIN                                                                                                                                                                              +
   BEGIN                                                                                                                                                                            +
     EXECUTE 'INSERT INTO lua_uniq VALUES ($1)' USING k;                                                                                                                            +
     ok := true;                                                                                                                                                                    +
     err := NULL;                                                                                                                                                                   +
     __plx_e1_sqlstate := NULL; __plx_e1_detail := NULL; __plx_e1_hint := NULL; __plx_e1_constraint := NULL;                                                                        +
   EXCEPTION WHEN OTHERS THEN                                                                                                                                                       +
     ok := false;                                                                                                                                                                   +
     err := SQLERRM;                                                                                                                                                                +
     GET STACKED DIAGNOSTICS __plx_e1_sqlstate = RETURNED_SQLSTATE, __plx_e1_detail = PG_EXCEPTION_DETAIL, __plx_e1_hint = PG_EXCEPTION_HINT, __plx_e1_constraint = CONSTRAINT_NAME;+
   END;                                                                                                                                                                             +
   IF ok THEN                                                                                                                                                                       +
     RETURN 'inserted';                                                                                                                                                             +
   END IF;                                                                                                                                                                          +
   IF __plx_e1_sqlstate = '23505' THEN                                                                                                                                              +
     RETURN 'duplicate on ' || __plx_e1_constraint || ': ' || err;                                                                                                                  +
   END IF;                                                                                                                                                                          +
   IF __plx_e1_detail <> '' AND __plx_e1_hint <> '' THEN RAISE EXCEPTION USING ERRCODE = __plx_e1_sqlstate, MESSAGE = err, DETAIL = __plx_e1_detail, HINT = __plx_e1_hint;          +
   ELSIF __plx_e1_detail <> '' THEN RAISE EXCEPTION USING ERRCODE = __plx_e1_sqlstate, MESSAGE = err, DETAIL = __plx_e1_detail;                                                     +
   ELSIF __plx_e1_hint <> '' THEN RAISE EXCEPTION USING ERRCODE = __plx_e1_sqlstate, MESSAGE = err, HINT = __plx_e1_hint;                                                           +
   ELSE RAISE EXCEPTION USING ERRCODE = __plx_e1_sqlstate, MESSAGE = err;                                                                                                           +
   END IF;                                                                                                                                                                          +
 END;                                                                                                                                                                               +
 
(1 row)

-- error(err) raises the caught error again with its SQLSTATE, detail and hint
CREATE FUNCTION lua_rethrow() RETURNS text LANGUAGE plxlua AS $$
local ok, err = pcall(function()
  error{message = "bad input", sqlstate = "22023", hint = "try again"}
end)
if err.sqlstate ~= "22023" then return "other" end
error(err)
$$;
