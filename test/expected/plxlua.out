\set VERBOSITY terse
CREATE FUNCTION lua_bad() RETURNS int LANGUAGE plxlua AS $$ local function f() return 1 end return f() $$;
ERROR:  plxlua: local function definitions are not supported
CREATE FUNCTION lua_bad() RETURNS int LANGUAGE plxlua AS $$ local f = function() return 1 end return 1 $$;
ERROR:  plxlua: functions are not supported (only the pcall(function() ... end) form)
CREATE FUNCTION lua_bad() RETURNS int LANGUAGE plxlua AS $$ local t = {a = 1} return 1 $$;
ERROR:  plxlua: a table with keys is a map, which is not supported; only an array constructor {a, b, c} is
CREATE FUNCTION lua_bad() RETURNS int LANGUAGE plxlua AS $$ for k, v in pairs(x) do end return 1 $$;
ERROR:  plxlua: pairs() iterates a table as a map, which is not supported; use ipairs() for an array
CREATE FUNCTION lua_bad() RETURNS int LANGUAGE plxlua AS $$ goto skip return 1 ::skip:: return 2 $$;
ERROR:  plxlua: goto skip: goto is only supported for continue (::skip:: as the last statement of the loop body) and for break (::skip:: right after the loop)
CREATE FUNCTION lua_bad() RETURNS int LANGUAGE plxlua AS $$ ::top:: return 1 $$;
ERROR:  plxlua: labels are only supported for the loop idioms: ::continue:: as the last statement of a loop body, or a break target right after a loop
