   x integer;                                                                                                   +
   y integer;                                                                                                   +
   __plx_t_1 integer;                                                                                           +
   __plx_t_2 integer;                                                                                           +
   p int := 1;                                                                                                  +
   q int;                                                                                                       +
   t integer[] := ARRAY[1, 2];                                                                                  +
 BEGIN                                                                                                          +
   x := a;                                                                                                      +
   y := b;                                                                                                      +
   __plx_t_1 := y;                                                                                              +
   __plx_t_2 := x;                                                                                              +
   x := __plx_t_1;                                                                                              +
   y := __plx_t_2;                                                                                              +
   t[1] := 10;                                                                                                  +
   t[2] := 20;                                                                                                  +
   RETURN x::text || ',' || y::text || ',' || p::text || ',' || (q IS NULL)::text || ',' || (t[1] + t[2])::text;+
 END;                                                                                                           +
 
