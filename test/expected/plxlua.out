-- ================================================================ scoping
-- locals are block scoped: a shadowing local, a same-scope redeclaration of
-- another type, and a name that differs only in case get their own variable
CREATE FUNCTION lua_scopes(n int) RETURNS text LANGUAGE plxlua AS $$
local x = 1
local out = ""
do
  local x = "inner"
  out = out .. x
end
for i = 1, 2 do
  local x = i * 10
  out = out .. "," .. x
end
local X = 5
local n = n * 100
local y = 1
local y = "now text"
return out .. "," .. x .. "," .. X .. "," .. n .. "," .. y
$$;
SELECT lua_scopes(3);
          lua_scopes          
------------------------------
 inner,10,20,1,5,300,now text
(1 row)

SELECT lua_src('lua_scopes');
                                           lua_src                                           
---------------------------------------------------------------------------------------------
 DECLARE                                                                                    +
   x integer := 1;                                                                          +
   out public.plx_strbuild := '';                                                           +
   x_2 text;                                                                                +
   x_3 integer;                                                                             +
   n_2 integer;                                                                             +
   y integer := 1;                                                                          +
   y_2 text := 'now text';                                                                  +
 BEGIN                                                                                      +
   x_2 := 'inner';                                                                          +
   out := public.plx_sb_append(out, x_2);                                                   +
   FOR i IN 1..2 LOOP                                                                       +
     x_3 := i * 10;                                                                         +
     out := public.plx_sb_append(out, ',' || x_3::text);                                    +
   END LOOP;                                                                                +
   x_3 := 5;                                                                                +
   n_2 := n * 100;                                                                          +
   RETURN out::text || ',' || x::text || ',' || x_3::text || ',' || n_2::text || ',' || y_2;+
 END;                                                                                       +
 
(1 row)

-- a local in a loop body is nil again on every iteration
CREATE FUNCTION lua_fresh() RETURNS text LANGUAGE plxlua AS $$
local out = ""
for i = 1, 3 do
  local seen --:: int
  if i == 2 then seen = i end
  out = out .. tostring(seen ~= nil)
end
return out
$$;
