 second
(2 rows)

SELECT lua_src('lua_dml');
                                      lua_src                                      
-----------------------------------------------------------------------------------
 DECLARE                                                                          +
   n bigint;                                                                      +
 BEGIN                                                                            +
   EXECUTE 'INSERT INTO lua_log(msg) VALUES ($1)' USING note || '!';              +
   INSERT INTO lua_log(msg) VALUES ('second');                                    +
   PERFORM * FROM (SELECT 1) AS __plx_p_1;                                        +
   EXECUTE 'UPDATE lua_log SET msg = upper(msg) WHERE msg = $1' USING note || '!';+
   GET DIAGNOSTICS n = ROW_COUNT;                                                 +
   RETURN n;                                                                      +
 END;                                                                             +
 
(1 row)

-- cursors
CREATE FUNCTION lua_cursor() RETURNS bigint LANGUAGE plxlua AS $$
local total = 0 --:: bigint
local c = open_cursor("SELECT sal FROM lua_emp ORDER BY id")
local row = fetch_from(c)
while found() do
  total = total + row.sal
  row = fetch_from(c)
end
close_cursor(c)
local c2 = open_cursor("SELECT id FROM lua_emp ORDER BY id")
move_cursor(c2)
local r = fetch_from(c2)
close_cursor(c2)
return total + r.id
$$;
SELECT lua_cursor();
 lua_cursor 
------------
        302
(1 row)

SELECT lua_src('lua_cursor');
                      lua_src                      
---------------------------------------------------
 DECLARE                                          +
   total bigint := 0;                             +
   c refcursor;                                   +
   row RECORD;                                    +
   c2 refcursor;                                  +
   r RECORD;                                      +
 BEGIN                                            +
   OPEN c FOR SELECT sal FROM lua_emp ORDER BY id;+
   FETCH FROM c INTO row;                         +
   WHILE FOUND LOOP                               +
     total := total + row.sal;                    +
     FETCH FROM c INTO row;                       +
   END LOOP;                                      +
   CLOSE c;                                       +
   OPEN c2 FOR SELECT id FROM lua_emp ORDER BY id;+
   MOVE FROM c2;                                  +
   FETCH FROM c2 INTO r;                          +
   CLOSE c2;                                      +
   RETURN total + r.id;                           +
 END;                                             +
 
(1 row)

