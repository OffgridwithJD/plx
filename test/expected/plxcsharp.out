 BEGIN                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                         +
   f := 8.5::real;                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                             +
   dt := ('2024-03-15 10:20:30')::timestamp;                                                                                                                                                                                                                                                                                                                                                                                                                                                                                   +
   day := ('2024-03-15')::date;                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                +
   span := ('01:02:03')::interval;                                                                                                                                                                                                                                                                                                                                                                                                                                                                                             +
   g := ('a0eebc99-9c0b-4ef8-bb6d-6bb9bd380a11')::uuid;                                                                                                                                                                                                                                                                                                                                                                                                                                                                        +
   raw := NULL;                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                +
   arr := ARRAY[1, 2, 3]::integer[];                                                                                                                                                                                                                                                                                                                                                                                                                                                                                           +
   v4 := 5::bigint;                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            +
