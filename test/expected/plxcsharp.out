-- procedures can commit; a DO block is C# too
CREATE TABLE cs_log(msg text);
CREATE PROCEDURE cs_proc(n int) LANGUAGE plxcsharp AS $$
for (int i = 1; i <= n; i++)
{
    execute("INSERT INTO cs_log VALUES ($1)", $"row {i}");
    if (i % 2 == 0) commit();
}
$$;
CALL cs_proc(3);
