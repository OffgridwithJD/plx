SET client_min_messages = notice;
DO LANGUAGE plxcsharp $$
for (int i = 1; i <= 2; i++) Console.WriteLine($"do block {i}");
Console.WriteLine("{0} + {1} = {2}", 1, 2, 1 + 2);
Console.WriteLine();
raise("warning", "raised at the warning level");
$$;
