-- throw; rethrows the caught error unchanged
CREATE FUNCTION cs_rethrow(v int) RETURNS int LANGUAGE plxcsharp AS $$
try { return 1 / v; }
catch (Exception e) { throw; }
$$;
SELECT cs_rethrow(0);
ERROR:  division by zero
