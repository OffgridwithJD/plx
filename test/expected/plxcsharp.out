-- set-returning functions: yield return, yield break, return_query, and
-- RETURNS TABLE with return_next()
CREATE FUNCTION cs_squares(n int) RETURNS SETOF int LANGUAGE plxcsharp AS $$
for (int i = 1; i <= n; i++)
{
    if (i > 4) yield break;
    yield return i * i;
}
$$;
