CREATE FUNCTION cs_table(g int) RETURNS TABLE(id int, label text) LANGUAGE plxcsharp AS $$
foreach (cs_orders o in query($"SELECT * FROM cs_orders WHERE grp = {g} ORDER BY id"))
{
    id = o.id;
    label = $"#{o.id}: {o.amount}";
    return_next();
}
$$;
