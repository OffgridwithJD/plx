   r bigint;                                                                                             +
 BEGIN                                                                                                   +
   EXECUTE 'UPDATE cs_orders SET amount = amount + $1 WHERE id = $2' USING 0, 1;                         +
   EXECUTE 'SELECT sum(' || quote_ident((col)::text) || ') FROM cs_orders WHERE grp = $1' INTO r USING g;+
   RETURN r;                                                                                             +
 END;                                                                                                    +
 
